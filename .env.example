# tiny-wae — variables d'environnement (copier en .env ; .env n'est JAMAIS commité)
DATABASE_URL=postgresql://app:app@localhost:5432/app

# ── Surcharges de config/settings.yaml (une variable par clé, préfixe TINY_WAE_) ────────
# Toutes optionnelles : présentes seulement pour documenter ce qui est surchargeable.
# Priorité : variable d'env > config/settings.yaml > défaut.
# TINY_WAE_STAC_URL=https://earth-search.aws.element84.com/v1
# TINY_WAE_STAC_COLLECTION=sentinel-2-l2a
# TINY_WAE_ASSET_KEYS=blue,green,red,nir,rededge1,rededge2,rededge3,nir08,swir16,swir22,scl
# TINY_WAE_CLOUD_PCT_MAX=30
# TINY_WAE_SCENE_CLOUD_MAX=95
# TINY_WAE_INVALID_PCT_MAX=1
# TINY_WAE_DATA_ROOT=./data
# TINY_WAE_INCREMENTAL_MARGIN_DAYS=3
# TINY_WAE_HTTP_RETRIES=3
# TINY_WAE_HTTP_BACKOFF_S=2
# TINY_WAE_BACKFILL_WORKERS=6
# TINY_WAE_CHIP_PX_10M=512
# TINY_WAE_CHIP_PX_20M=256

# ⭐ Garde réseau de contrat (décision E-b) : posée ici, consommée par adapters/chips.py
